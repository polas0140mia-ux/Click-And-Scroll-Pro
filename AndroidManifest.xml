<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ইন্টারনেট ও নেটওয়ার্ক পারমিশন (AdMob বিজ্ঞাপনের জন্য প্রয়োজন) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ফ্লোটিং ওভারলে প্যানেল অন্য অ্যাপের ওপর দেখানোর পারমিশন -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ফোরগ্রাউন্ড সার্ভিস পারমিশন -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:label="Click &amp; Scroll Pro"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
        tools:targetApi="34">

        <!--
            Google AdMob App ID (বর্তমানে অফিশিয়াল টেস্ট ID দেওয়া আছে)
            আপনার আসল AdMob App ID এখানে বসাবেন: ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- কোর অটো ক্লিকার ও অটো-স্ক্রল Accessibility Service -->
        <service
            android:name=".AutoClickerService"
            android:exported="false"
            android:label="Click &amp; Scroll Pro Service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
